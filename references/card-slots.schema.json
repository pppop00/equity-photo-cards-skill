{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pppop00/equity-photo-cards-skill/card-slots.schema.json",
  "title": "Anamnesis five-card company-country knowledge map slots (v5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "intro_sentence", "one_minute_summary", "metrics_row",
    "industry_paragraph", "background_bullets", "porter_evidence",
    "five_year_arc", "financial_metrics_panel", "company_quality", "country_lens"
  ],
  "properties": {
    "schema_version": { "const": 5 },
    "logo_asset_path": { "type": "string" },
    "cover_company_name_cn": { "type": "string" },
    "intro_sentence": { "type": "string", "minLength": 1 },
    "one_minute_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["business_model", "core_variables", "primary_risk"],
      "properties": {
        "business_model": { "type": "string", "minLength": 1, "maxLength": 64 },
        "core_variables": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
        "primary_risk": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "metrics_row": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string", "pattern": ".+\\|.+" } },
    "industry_paragraph": { "type": "string", "minLength": 1 },
    "background_bullets": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/externalCondition" },
        { "$ref": "#/$defs/transmission" },
        { "$ref": "#/$defs/companyOutcome" },
        { "$ref": "#/$defs/watchSignal" }
      ],
      "items": false
    },
    "porter_scores": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "integer", "minimum": 1, "maximum": 5 } },
    "porter_evidence": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["force", "score", "evidence"],
        "properties": {
          "force": { "enum": ["rivalry", "new_entrants", "supplier_power", "buyer_power", "substitutes"] },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "five_year_arc": {
      "type": "object", "additionalProperties": false,
      "required": ["narrative", "inflection_points"],
      "properties": {
        "narrative": { "type": "string", "minLength": 1 },
        "inflection_points": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "financial_metrics_panel": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/profitabilityMetric" }, { "$ref": "#/$defs/profitabilityMetric" }, { "$ref": "#/$defs/profitabilityMetric" },
        { "$ref": "#/$defs/cashFlowMetric" }, { "$ref": "#/$defs/cashFlowMetric" }, { "$ref": "#/$defs/leverageMetric" }
      ],
      "items": false
    },
    "company_quality": {
      "type": "object", "additionalProperties": false,
      "required": ["valuation", "governance_incentives", "capital_allocation", "accounting_quality", "unknown"],
      "properties": {
        "valuation": { "$ref": "#/$defs/valuationPanel" },
        "governance_incentives": { "$ref": "#/$defs/qualityPanel" },
        "capital_allocation": { "$ref": "#/$defs/qualityPanel" },
        "accounting_quality": { "$ref": "#/$defs/qualityPanel" },
        "unknown": { "type": "string", "minLength": 1 }
      }
    },
    "country_lens": {
      "type": "object", "additionalProperties": false,
      "required": ["exposure_map", "dimensions", "top_warnings", "company_to_country_insight", "unknown"],
      "properties": {
        "exposure_map": {
          "type": "object", "additionalProperties": false,
          "required": ["incorporation", "listing", "operations", "revenue"],
          "properties": {
            "incorporation": { "type": "string", "minLength": 1 }, "listing": { "type": "string", "minLength": 1 },
            "operations": { "type": "string", "minLength": 1 }, "revenue": { "type": "string", "minLength": 1 }
          }
        },
        "dimensions": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "prefixItems": [
            { "$ref": "#/$defs/taxDimension" }, { "$ref": "#/$defs/fxDimension" }, { "$ref": "#/$defs/regulationDimension" },
            { "$ref": "#/$defs/laborDimension" }, { "$ref": "#/$defs/cultureDimension" }, { "$ref": "#/$defs/minorityDimension" }
          ],
          "items": false
        },
        "top_warnings": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
        "company_to_country_insight": { "type": "string", "minLength": 1 },
        "unknown": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "backgroundChainEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["step", "text"],
      "properties": {
        "step": { "type": "string" },
        "text": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    },
    "externalCondition": {
      "allOf": [
        { "$ref": "#/$defs/backgroundChainEntry" },
        { "properties": { "step": { "const": "external_condition" } } }
      ]
    },
    "transmission": {
      "allOf": [
        { "$ref": "#/$defs/backgroundChainEntry" },
        { "properties": { "step": { "const": "transmission" } } }
      ]
    },
    "companyOutcome": {
      "allOf": [
        { "$ref": "#/$defs/backgroundChainEntry" },
        { "properties": { "step": { "const": "company_outcome" } } }
      ]
    },
    "watchSignal": {
      "allOf": [
        { "$ref": "#/$defs/backgroundChainEntry" },
        { "properties": { "step": { "const": "watch_signal" } } }
      ]
    },
    "metricBase": {
      "type": "object", "additionalProperties": false,
      "required": ["label_cn", "value", "period_cn", "category"],
      "properties": {
        "label_cn": { "type": "string", "minLength": 1, "maxLength": 12 },
        "value": { "type": "string", "minLength": 1, "maxLength": 14 },
        "period_cn": { "type": "string", "minLength": 1, "maxLength": 14 },
        "category": { "type": "string" }
      }
    },
    "profitabilityMetric": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "category": { "const": "profitability" } } }] },
    "cashFlowMetric": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "category": { "const": "cash_flow" } } }] },
    "leverageMetric": { "allOf": [{ "$ref": "#/$defs/metricBase" }, { "properties": { "category": { "const": "leverage" } } }] },
    "qualityPanel": {
      "type": "object", "additionalProperties": false,
      "required": ["finding", "evidence", "watch_item"],
      "properties": {
        "finding": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 }, "watch_item": { "type": "string", "minLength": 1 }
      }
    },
    "valuationMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["label_cn", "value", "basis_label", "as_of_date"],
      "properties": {
        "label_cn": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 },
        "basis_label": { "type": "string", "minLength": 1 }, "as_of_date": { "type": "string", "format": "date" }
      }
    },
    "valuationPanel": {
      "type": "object", "additionalProperties": false,
      "required": ["finding", "evidence", "watch_item", "metrics"],
      "properties": {
        "finding": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 },
        "watch_item": { "type": "string", "minLength": 1 },
        "metrics": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/valuationMetric" } }
      }
    },
    "countryDimension": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "label_cn", "country_fact", "company_transmission", "watch_metric"],
      "properties": {
        "key": { "type": "string" }, "label_cn": { "type": "string", "minLength": 1 },
        "country_fact": { "type": "string", "minLength": 1 }, "company_transmission": { "type": "string", "minLength": 1 },
        "watch_metric": { "type": "string", "minLength": 1 }
      }
    },
    "taxDimension": { "allOf": [{ "$ref": "#/$defs/countryDimension" }, { "properties": { "key": { "const": "tax" } } }] },
    "fxDimension": { "allOf": [{ "$ref": "#/$defs/countryDimension" }, { "properties": { "key": { "const": "fx_inflation" } } }] },
    "regulationDimension": { "allOf": [{ "$ref": "#/$defs/countryDimension" }, { "properties": { "key": { "const": "regulation" } } }] },
    "laborDimension": { "allOf": [{ "$ref": "#/$defs/countryDimension" }, { "properties": { "key": { "const": "labor" } } }] },
    "cultureDimension": { "allOf": [{ "$ref": "#/$defs/countryDimension" }, { "properties": { "key": { "const": "consumer_culture" } } }] },
    "minorityDimension": { "allOf": [{ "$ref": "#/$defs/countryDimension" }, { "properties": { "key": { "const": "minority_shareholder_protection" } } }] }
  }
}
